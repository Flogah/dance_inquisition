dialogs = {
"TEST_CONVERSATION_DIALOG_1": {
"de": "",
"default": "Wolfram, kann ich einen Moment deiner Zeit in Anspruch nehmen? Ich habe ein paar Gedanken, die ich gerne mit dir teilen würde.",
"en": ""
},
"TEST_CONVERSATION_DIALOG_2": {
"de": "",
"default": "Aber Herr Inquisitor, für sie habe ich doch immer Zeit. Was kann ich für Sie tun?",
"en": ""
},
"TEST_CONVERSATION_DIALOG_3": {
"de": "",
"default": "Was kannst du mir über dieses Buch sagen? Ich habe es unter deinen Dingen gefunden.",
"en": ""
},
"TEST_CONVERSATION_DIALOG_4": {
"de": "",
"default": "Gehen Sie mit Gott, Herr Inquisitor.",
"en": ""
},
"TEST_CONVERSATION_DIALOG_5": {
"de": "",
"default": "Wie können Sie es wagen! Sie gehen zu weit! Das ist mein persönliches Eigentum!",
"en": ""
},
"TEST_CONVERSATION_DIALOG_6": {
"de": "",
"default": "Als hätten Sie anders gehandelt, an meiner Stelle!
Ich würde es wieder tun, wenn ich es müsste.",
"en": ""
},
"TEST_CONVERSATION_DIALOG_7": {
"de": "",
"default": "Ich hoffe nicht.",
"en": ""
},
"TEST_CONVERSATION_DIALOG_8": {
"de": "",
"default": "Ach?",
"en": ""
},
"TEST_CONVERSATION_DIALOG_9": {
"de": "",
"default": "Möge der Teufel Sie holen.",
"en": ""
},
"TEST_CONVERSATION_OPT1_1": {
"default": "[i]Zeige das ketzerische Buch.[/i]"
},
"TEST_CONVERSATION_OPT1_2": {
"default": "Bis später."
}
}
